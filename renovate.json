{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "description": "Keeps Helm chart versions, container images and OpenTofu providers current. Chart versions live in three places (deploy scripts, the platform ApplicationSet, and base values), so they are grouped to land in one PR.",
  "timezone": "Europe/Oslo",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Platform Helm charts \u2014 one PR per chart, covering every file that pins it",
      "matchManagers": [
        "helm-values",
        "helmv3",
        "regex"
      ],
      "groupName": "helm chart {{depName}}",
      "separateMinorPatch": true
    },
    {
      "description": "OpenTofu providers",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "opentofu providers"
    },
    {
      "description": "Patch-level bumps of platform charts can merge automatically once CI is green",
      "matchManagers": [
        "regex"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Chart versions pinned in the deploy scripts (--version <x>)",
      "managerFilePatterns": [
        "/^k8s/scripts/.*\\.sh$/"
      ],
      "matchStrings": [
        "helm upgrade --install \\S+ (?<depName>[a-z0-9-]+/[a-z0-9-]+)[\\s\\S]{0,400}?--version v?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.helm.sh/stable"
    },
    {
      "customType": "regex",
      "description": "Chart versions in the platform ApplicationSet",
      "managerFilePatterns": [
        "/^k8s/argocd/platform-appset\\.yaml$/"
      ],
      "matchStrings": [
        "chart: (?<depName>\\S+)\\s+repo: (?<registryUrl>\\S+)\\s+version: v?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Container images pinned in manifests and values",
      "managerFilePatterns": [
        "/^k8s/.*\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>[a-z0-9./-]+):(?<currentValue>v?[0-9][^\\s\"']*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "OCI Helm charts referenced by URL in the deploy scripts",
      "managerFilePatterns": [
        "/^k8s/scripts/.*\\.sh$/"
      ],
      "matchStrings": [
        "oci://(?<packageName>[^\\s]+?)\\s+[\\s\\S]{0,200}?--version \"?\\$?\\{?[A-Z_]*\"?\\s*#\\s*renovate:\\s*(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Chart version constants at the top of deploy.sh",
      "managerFilePatterns": [
        "/^k8s/scripts/deploy(-workload)?\\.sh$/"
      ],
      "matchStrings": [
        "CHART_[A-Z_]+=\"v?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*#\\s*(?<depName>[^\\s]+)\\s+(?<registryUrl>https?://[^\\s]+)"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}

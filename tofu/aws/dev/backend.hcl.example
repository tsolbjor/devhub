# Bootstrap once per account (bucket + lock table must exist before `tofu init`):
#   aws s3api create-bucket --bucket devhub-tfstate --region eu-west-1 \
#     --create-bucket-configuration LocationConstraint=eu-west-1
#   aws s3api put-bucket-versioning --bucket devhub-tfstate \
#     --versioning-configuration Status=Enabled
#   aws s3api put-bucket-encryption --bucket devhub-tfstate \
#     --server-side-encryption-configuration \
#     '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#   aws dynamodb create-table --table-name devhub-tfstate-lock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST
bucket         = "devhub-tfstate"
key            = "aws/dev/terraform.tfstate"
region         = "eu-west-1"
dynamodb_table = "devhub-tfstate-lock"
encrypt        = true

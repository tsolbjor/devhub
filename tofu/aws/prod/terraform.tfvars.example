# Copy to terraform.tfvars (gitignored) and adjust.
# [] means the API server has no public endpoint — reach it over VPN/bastion.
api_allowed_cidrs = ["203.0.113.4/32"]

# Deployment identity: names every resource and the globally-unique namespaces
# (buckets, Cognito domain / storage account). One per deployment, e.g. "acme-prod".
prefix = "devhub-prod"

# Who configured this deployment — used only in tags. setup-env.sh fills it in.
deployed_by = "you@example.org"

# Copy to terraform.tfvars (gitignored) and adjust.
# [] means the API server has no public endpoint — reach it over VPN/bastion.
api_allowed_cidrs = ["203.0.113.4/32"]

# Entra ID groups that get cluster-admin. Setting this disables the AKS local
# admin account (a permanent, unauditable cluster-admin certificate).
aad_admin_group_object_ids = ["00000000-0000-0000-0000-000000000000"]

# Deployment identity: names every resource and the globally-unique namespaces
# (buckets, Cognito domain / storage account). One per deployment, e.g. "acme-prod".
prefix = "devhub-prod"

# Who configured this deployment — used only in tags. setup-env.sh fills it in.
deployed_by = "you@example.org"

# Public domain — the Azure DNS zone for it must already exist.
domain = "example.org"
# Resource group holding that DNS zone (omit to look in this deployment's RG).
# dns_zone_resource_group = "my-dns-rg"

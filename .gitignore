# Environment files with secrets
.env
*.env.local

# Visual Studio solution files
*.sln

# Terraform/OpenTofu
# Note: .terraform.lock.hcl is deliberately NOT ignored — provider checksums must
# be committed so every apply and CI run resolves the same provider versions.
*.tfstate
*.tfstate.*
.terraform/

# Backend and variable files hold account-specific values (state bucket names,
# allowed API CIDRs, admin group IDs). Only the *.example templates are tracked.
backend.hcl
*.tfvars
!*.tfvars.example

# Kubernetes
*kubeconfig*.yaml
*kubeconfig*.yml

# Generated per-environment files: kubeconfig, tofu-outputs.env, secrets.env,
# manual-secrets.env, vault-init-keys.json, oidc-secrets.env.
#
# Generated per-environment state (interview answers, tofu outputs, kubeconfigs,
# secrets, Vault keys, logs). Everything except the README is machine-written
# and holds credentials. See _setup/README.md for the lifecycle.
_setup/*
!_setup/README.md

# The pre-_setup location of the same files; kept ignored so an old checkout
# that has not migrated yet still cannot commit credentials.
k8s/scripts/*/
!k8s/scripts/lib/
!k8s/scripts/windows/

# End-to-end suite: the runner, its browsers and everything a run produces.
# The saved storage state is a live signed-in session, so it is a credential.
k8s/e2e/node_modules/
k8s/e2e/.auth/
k8s/e2e/report/
k8s/e2e/results/
k8s/e2e/package-lock.json

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code: machine-local state. Shared config (.claude/settings.json,
# commands/, skills/) is deliberately not ignored — commit it if it appears.
.claude/worktrees/
.claude/settings.local.json
